              "name": "VFD_Speed_Control_ST",
              "language": "ST",
              "programName": "Station04_Sequence",
              "description": "IEC 61131-3 Structured Text VFD speed scaling & part counter routine",
              "stCode": "// ============================================================================\n// FactoryTalk Design Studio - Structured Text (IEC 61131-3)\n// Routine: VFD_Speed_Control_ST | Program: Station04_Sequence\n// ============================================================================\n\nREGION Safety_Guard_Check\n    IF NOT Master_EStop_Healthy OR NOT Safety_LightCurtain_OK THEN\n        Infeed_Conveyor_Run := FALSE;\n        Fixture_Clamp_Extend := FALSE;\n        Conveyor_Speed_RPM := 0.0;\n        RETURN;\n    END_IF;\nEND_REGION\n\nREGION Drive_Velocity_Regulation\n    IF Infeed_Conveyor_Run THEN\n        IF Conveyor_Speed_RPM >= Target_Speed_Setpoint THEN\n            IF Part_In_Position_PE AND NOT Robot_Welding_Active THEN\n                Fixture_Clamp_Extend := TRUE;\n                Total_Produced_Parts := Total_Produced_Parts + 1;\n            END_IF;\n        END_IF;\n    ELSE\n        Conveyor_Speed_RPM := 0.0;\n    END_IF;\nEND_REGION\n",
              "rungs": [],
              "fbdNodes": [],
              "fbdWires": []
            },
